extends RefCounted

const Catalog = preload("res://src/features/defense/domain/defense_catalog.gd")
const Lab = preload("res://src/features/defense/domain/lab/battle_lab.gd")
const U = preload("res://src/features/defense/domain/defense_units.gd")

func run(test) -> void:
	var catalog = Catalog.new()
	test.assert_equal(catalog.load_default(), "", "load laboratory definitions")
	_controls(test, catalog)
	_terms(test, catalog)
	_damage_modes(test, catalog)
	_cleanup(test, catalog)
	_replay(test, catalog)
	_scope(test, catalog)
	_kill_contract(test, catalog)
	_lifecycle(test, catalog)

func prepared(catalog):
	var lab = Lab.new(catalog)
	assert(lab.submit("add", {"kind": "hero", "template": 17, "pos": [800, 1000], "attributes": {"4": 100, "7": 0}}).is_empty())
	assert(lab.submit("add", {"template": 101, "pos": [800, 850], "attributes": {"1": 1000}, "actions": {"move": false, "attack": false, "skill": false}}).is_empty())
	return lab

func _controls(test, catalog) -> void:
	var lab = prepared(catalog)
	test.assert_equal(lab.world.units.size(), 2, "shared add command creates real actors")
	test.assert_equal(lab.submit("advance", {"ticks": 1}), "", "single step accepted while paused")
	test.assert_equal(lab.world.time_ms, 16, "one logical step is sixteen ms")
	test.assert_true(lab.world.paused, "single step preserves pause")
	var before: Dictionary = lab.state()
	test.assert_true(not lab.submit("add", {"template": -8, "layout": "random", "count": 3}).is_empty(), "invalid templates rejected")
	test.assert_equal(lab.state(), before, "invalid random spawn changes neither state nor RNG")
	test.assert_true(not lab.submit("attribute", {"attribute": "1", "value": -5}).is_empty(), "negative max HP rejected")
	test.assert_true(not lab.submit("advance", {"ticks": 0}).is_empty(), "zero step rejected")
	test.assert_true(not lab.submit("unknown").is_empty(), "unknown actions fail")
	var recipe: Dictionary = lab.recipe.duplicate(true)
	recipe.units[0].template = 99999
	test.assert_true(not lab.load_config(recipe).is_empty(), "bad configuration rejected")
	test.assert_equal(lab.state(), before, "failed configuration preserves live session")
	test.assert_equal(lab.submit("attribute", {"id": 2, "attribute": "1", "value": 5000}), "", "max HP edited")
	test.assert_equal(lab.submit("health", {"id": 2, "ratio": 0.2}), "", "health ratio edited")
	test.assert_equal(lab.inspect(2).hp, 1000.0, "HP edit reads back from authority")
	test.assert_equal(lab.submit("position", {"id": 2, "pos": [500, 600]}), "", "position adjusted")
	test.assert_equal(lab.inspect(2).pos, [500.0, 600.0], "new position readback")
	lab.dispose()

func _terms(test, catalog) -> void:
	var lab = prepared(catalog)
	var canonical: Dictionary = catalog.record("skills", 1435)
	test.assert_true(not lab.submit("term", {"id": 1, "term": 200508, "count": 1}).is_empty(), "legal mode rejects missing prerequisites")
	test.assert_equal(lab.submit("term", {"id": 1, "term": 200508, "count": 1, "prerequisites": true}), "", "explicit prerequisite completion works")
	test.assert_true(lab.inspect(1).terms.has(200506), "hunt prerequisite added")
	lab.submit("advance", {"ticks": 100})
	test.assert_equal(lab.submit("term", {"id": 1, "clear": true}), "", "remove terms by clean reconstruction")
	test.assert_equal(lab.world.time_ms, 0, "term edit starts a clean timeline")
	test.assert_equal(lab.inspect(1).terms, [200500], "only innate ability remains")
	test.assert_true(lab.world.missiles.is_empty() and lab.world.skills.queue.is_empty(), "no stale projectiles or queued casts")
	test.assert_equal(catalog.record("skills", 1435), canonical, "catalog never mutated")
	lab.submit("configure", {"legal_terms": false})
	test.assert_equal(lab.submit("term", {"id": 1, "term": 200508, "count": 3}), "", "free mode supports missing prerequisites and repeated terms")
	test.assert_equal(lab.inspect(1).terms.count(200508), 3, "free count is actual state")
	test.assert_true(not lab.submit("configure", {"legal_terms": true}).is_empty(), "cannot mislabel illegal build as legal")
	test.assert_true(not lab.recipe.legal_terms, "failed mode change retains free mode")
	lab.dispose()

func _damage_modes(test, catalog) -> void:
	var lab = prepared(catalog)
	var hero: Dictionary = lab.world.units[1]
	var enemy: Dictionary = lab.world.units[2]
	lab.submit("survival", {"id": 2, "mode": "immortal"})
	var received: float = lab.world.damage.hit(hero, enemy, 20000, false, true, {"kind": "attack"})
	test.assert_equal(received, 20000.0, "immortal target records full mitigated damage beyond max HP")
	test.assert_equal(lab.inspect(2).hp, 1000.0, "immortal restores HP in the damage transaction")
	test.assert_equal(hero.stats.damage, 20000.0, "damage statistics not limited by dummy HP")
	test.assert_true(not enemy.dead and hero.kills == 0, "immortal damage cannot trigger kill")
	lab.world.damage.execute(hero, enemy)
	test.assert_true(not enemy.dead, "execution cannot kill immortal target")
	test.assert_true(not lab.submit("kill", {"id": 2, "source": 1}).is_empty(), "manual kill refuses immortality")
	lab.submit("survival", {"id": 2, "mode": "invulnerable"})
	test.assert_equal(lab.world.damage.hit(hero, enemy, 100), 0.0, "invulnerable rejects damage")
	test.assert_equal(hero.stats.damage, 20000.0, "invulnerability adds no damage")
	lab.submit("survival", {"id": 2, "mode": "normal"})
	lab.submit("shield", {"id": 2, "value": 80})
	lab.world.damage.hit(hero, enemy, 50, false, false)
	lab.submit("shield", {"id": 2, "value": 20})
	test.assert_equal(enemy.shield, 20.0, "manual shield tracks consumed capacity")
	lab.submit("clear", {"scope": "enemies"})
	test.assert_equal(lab.world.kills, 0, "clear does not count a kill")
	test.assert_equal(hero.kills, 0, "clear does not grant credit")
	lab.dispose()

func _cleanup(test, catalog) -> void:
	var lab = prepared(catalog)
	lab.submit("status", {"id": 2, "source": 1, "status": 4, "duration_ms": 1000})
	test.assert_equal(lab.inspect(2).statuses.size(), 1, "shared status command creates real status")
	lab.submit("clear", {"id": 1})
	test.assert_equal(lab.inspect(2).statuses.size(), 0, "clear removes statuses from removed source")
	test.assert_equal(lab.submit("advance", {"ticks": 100}), "", "advance remains valid after source removal")
	lab.submit("clear", {"scope": "all"})
	test.assert_true(lab.world.core._entities.is_empty(), "clear removes authoritative core entities")
	test.assert_true(lab.world.skills.thorns.flowers.is_empty(), "clear removes flower ownership")
	var spec = preload("res://src/features/defense/domain/lab/lab_config.gd").unit(1, "hero", 1, [800, 1100])
	var config = preload("res://src/features/defense/domain/lab/lab_config.gd").empty()
	config.units.append(spec)
	test.assert_equal(lab.load_config(JSON.parse_string(JSON.stringify(config))), "", "external JSON configuration loads")
	lab.submit("clear", {"scope": "all"})
	test.assert_true(lab.recipe.units.is_empty(), "JSON identities clear from recipe as well as world")
	test.assert_equal(lab.submit("add", {"kind": "hero", "template": 1}), "", "same hero can be summoned after clearing a loaded recipe")
	lab.dispose()

func _replay(test, catalog) -> void:
	var lab = prepared(catalog)
	lab.submit("add", {"template": 101, "count": 3, "layout": "random", "pos": [800, 700], "spacing": 100})
	lab.submit("attribute", {"id": 1, "attribute": "4", "value": 200})
	lab.submit("select", {"id": 1})
	lab.submit("attribute", {"attribute": "4", "value": 220})
	lab.submit("advance", {"ticks": 250})
	var expected: Dictionary = lab.state()
	var document: Dictionary = JSON.parse_string(JSON.stringify(lab.document()))
	test.assert_equal(lab.replay(document), "", "JSON round-trip and command replay succeed")
	test.assert_equal(lab.state(), expected, "same setup and fixed-step journal reproduce exact state and RNG")
	document.commands = [{"action": "advance", "payload": {"ticks": 1.5}}]
	test.assert_true(not lab.replay(document).is_empty(), "fractional replay ticks rejected without looping")
	test.assert_equal(lab.state(), expected, "bad replay is transactional")
	lab.dispose()

func _lifecycle(test, catalog) -> void:
	var lab = prepared(catalog)
	lab.submit("configure", {"settings": {"spawn": false, "progression": false, "respawn": true}})
	lab.submit("kill", {"id": 2, "source": 1})
	test.assert_equal(lab.world.replacements.size(), 1, "death schedules one replacement")
	lab.submit("advance", {"ticks": 63})
	var replacement = preload("res://src/features/defense/domain/lab/lab_units.gd").find(lab.world, 2)
	test.assert_true(not replacement.is_empty() and not replacement.dead and replacement.id != 2, "replacement uses a new actual unit and stable configuration key")
	lab.submit("kill", {"id": replacement.id, "source": 1})
	lab.submit("clear", {"scope": "enemies"})
	lab.submit("advance", {"ticks": 70})
	test.assert_true(lab.world.replacements.is_empty() and lab.world.units.size() == 1, "enemy clear cancels pending respawn")
	lab.submit("kill", {"id": 1})
	test.assert_true(lab.inspect(1).dead, "hero can die for death tests")
	test.assert_equal(lab.submit("revive", {"id": 1}), "", "hero test revive uses actual lifecycle")
	test.assert_true(not lab.inspect(1).dead, "revival takes effect")
	lab.submit("configure", {"settings": {"spawn": true, "progression": true, "respawn": false}})
	lab.submit("wall", {"hp": 0})
	lab.submit("advance", {"ticks": 1})
	test.assert_equal(lab.world.phase, "result", "full progression runs real defeat settlement")
	lab.dispose()

func _scope(test, catalog) -> void:
	var lab = prepared(catalog)
	lab.submit("add", {"template": 101, "count": 2, "layout": "row"})
	lab.submit("attribute", {"scope": "enemies", "attribute": "4", "value": 11})
	for actor in lab.world.units.values():
		test.assert_equal(U.stat(actor, 4), 100.0 if actor.kind == "hero" else 11.0, "batch edit respects faction")
	lab.submit("clear", {"scope": "enemies"})
	test.assert_equal(lab.world.units.size(), 1, "all enemy clear leaves hero")
	lab.dispose()

func _kill_contract(test, catalog) -> void:
	var lab = prepared(catalog)
	lab.submit("term", {"id": 1, "term": 200506, "count": 1, "prerequisites": true})
	lab.submit("weaken", {"id": 2})
	lab.submit("actions", {"id": 1, "move": false, "attack": false, "skill": true})
	lab.submit("advance", {"ticks": 100})
	test.assert_equal(lab.inspect(1).kills, 1, "real assassination receives kill credit")
	test.assert_true(lab.world.units[1].skills[1435].hunt_ready, "real skill kill arms hunt")
	lab.submit("reset")
	lab.submit("kill", {"id": 2, "source": 1})
	test.assert_equal(lab.inspect(1).kills, 1, "manual kill uses generic kill path")
	test.assert_true(not lab.world.units[1].skills[1435].get("hunt_ready", false), "manual kill cannot fake skill-specific hunt")
	lab.dispose()
