extends RefCounted

const Mouse = preload("res://tests/test_defense_choice_ui.gd")
const U = preload("res://src/features/defense/domain/defense_units.gd")

func run(test: TestSupport, tree: SceneTree) -> void:
	var mouse = Mouse.new()
	var app = load("res://scenes/main.tscn").instantiate()
	tree.root.add_child(app)
	await tree.process_frame
	app.set_process(false)
	var view = app.get_node("DefenseView")
	var panels = view.get_node("BattlePanels")
	var terms = view.get_node("HeroTerms")
	var choice = view.get_node("ChoicePanel")
	view.intent_requested.emit("start", {"seed": 3})
	await tree.create_timer(0.7).timeout
	var fire_index := -1
	for i in range(app.battle_snapshot().offers.size()):
		if app.battle_snapshot().offers[i].id == 1:
			fire_index = i
	await mouse.click(tree, view.get_node("HUD/GemStats"))
	test.assert_true(panels.get_node("Gems").visible, "gem button is reachable through choice shade")
	await mouse.click(tree, panels.get_node("Gems/Close"))
	test.assert_true(not panels.get_node("Gems").visible, "gem overlay dismisses without selecting a card")
	test.assert_equal(app.battle_snapshot().history.size(), 0, "gem report is read-only")
	await mouse.click(tree, view.get_node("HUD/BattleStats"))
	test.assert_true(panels.get_node("Contribution").visible, "empty contribution opens during choice")
	test.assert_equal(panels.get_node("Contribution/Rows").get_child_count(), 0, "empty roster has no fabricated contribution")
	await mouse.click(tree, view.get_node("HUD/BattleStats"))
	test.assert_true(not panels.get_node("Contribution").visible, "contribution button toggles its float")
	await mouse.click(tree, choice.get_node("Cards").get_child(fire_index).get_node("Info"))
	test.assert_true(panels.get_node("Hero").visible, "candidate info opens attributes")
	test.assert_equal(panels.hero.attributes, app._catalog.record("heroes", 1).base, "candidate attributes use fixed baseline definition")
	await mouse.click(tree, panels.get_node("Hero/Expand"))
	test.assert_true(panels.expanded, "attribute arrow expands real detail state")
	await mouse.click(tree, panels.get_node("Hero/Expand"))
	test.assert_true(not panels.expanded, "attribute arrow collapses")
	await mouse.click(tree, panels.get_node("Hero/Close"))
	await mouse.click(tree, view.get_node("HUD/Pause"))
	test.assert_true(app.battle_snapshot().paused, "pause button works during choice")
	test.assert_true(choice.visible, "paused choice remains visible behind blur")
	var before = app.battle_snapshot().offers.duplicate(true)
	await mouse.click(tree, panels.get_node("Pause/Monster3"))
	test.assert_true(panels.get_node("BossDetails").visible, "pause boss portrait opens its detail")
	test.assert_equal(panels.get_node("BossDetails/Paper/Name").text, panels.get_node("Pause/Monster3").monster.title, "boss detail matches clicked portrait")
	test.assert_equal(panels.get_node("BossDetails/Paper/Description").text, panels.get_node("Pause/Monster3").monster.description, "boss detail uses frozen Chinese description")
	await mouse.click(tree, panels.get_node("BossDetails/Close"), Vector2(480, 1450))
	test.assert_true(app.battle_snapshot().paused, "closing boss detail returns to pause")
	await mouse.click(tree, panels.get_node("Pause/Damage"))
	test.assert_true(not view.get_node("Field").damage_numbers, "damage checkbox controls presentation")
	test.assert_equal(app.battle_snapshot().offers, before, "pause inspection cannot redraw choice")
	await mouse.click(tree, panels.get_node("Pause/Resume"))
	test.assert_true(not app.battle_snapshot().paused and not choice.busy, "resume restores same selectable offer")
	await mouse.click(tree, choice.get_node("Cards").get_child(fire_index), Vector2(146, 315))
	await tree.create_timer(0.2).timeout
	var hero = app.session.units[app.session.heroes[0]]
	test.assert_equal(hero.template, 1, "post-pause card still recruits displayed hero")
	test.assert_true(not view.get_node("HUD/GemStats").visible, "gem button is hidden during combat")
	test.assert_true(view.get_node("HUD/MonsterInfo").visible, "combat exposes monster button")
	test.assert_equal(view.get_node("HUD/Hero0").hero.template, 1, "portrait reflects recruited hero")
	test.assert_true(view.get_node("HUD/Hero1/Portrait").disabled and view.get_node("HUD/Hero1/Skill").disabled, "empty roster slot is inactive")
	await mouse.click(tree, view.get_node("HUD/MonsterInfo"))
	test.assert_true(panels.get_node("Monsters").visible, "monster list opens")
	test.assert_true(not app.battle_snapshot().paused, "monster float does not pause combat")
	await mouse.click(tree, view.get_node("HUD/MonsterInfo"))
	test.assert_true(not panels.get_node("Monsters").visible, "monster button remains reachable while list is open")
	app.session.upgrades.apply(hero, 201)
	hero.core.attributes.set_value("hp", U.hp(hero) - 100)
	for _i in range(10):
		app.session.step()
	view.render(app.battle_snapshot())
	test.assert_equal(view.get_node("HUD/Hero0").hero.hp, U.hp(hero), "roster health reads real damage")
	test.assert_true(hero.upgrades.has(201), "fireball branch upgrade is learned by the recruited fire mage")
	test.assert_equal(view.get_node("HUD/Hero0").hero.skills[0].level, 2, "the fireball branch raises its own initial skill badge")
	var tooltip = view.get_node("SkillTooltip")
	await mouse.click(tree, view.get_node("HUD/Hero0/Skill"))
	test.assert_true(tooltip.visible and not panels.get_node("Hero").visible, "skill circle opens description instead of attributes")
	test.assert_true(not app.battle_snapshot().paused, "skill inspection does not pause combat")
	test.assert_equal(tooltip.get_node("Paper/Description").text, app._catalog.record("options", 200).description, "skill description matches displayed fire mage skill")
	var playing_clock = app.battle_snapshot().time
	app.session.step()
	test.assert_true(app.battle_snapshot().time > playing_clock, "rule clock advances while skill description is open")
	await mouse.click(tree, view.get_node("HUD/Hero0/Skill"))
	test.assert_true(not tooltip.visible, "same skill circle toggles its description off")
	await mouse.click(tree, view.get_node("HUD/Hero0"), Vector2(25, 300))
	test.assert_true(not app.battle_snapshot().paused, "blank space beside skill circle does not activate portrait")
	var skill_rect = view.get_node("HUD/Hero0/Skill").get_global_rect()
	for definition: Dictionary in app._catalog.records("heroes").values():
		if not definition.available:
			continue
		tooltip.dismiss()
		tooltip.toggle(0, app._catalog.record("options", int(definition.initial_options[0])).description, skill_rect)
		var paper = tooltip.get_node("Paper")
		test.assert_true(paper.position.y >= 1584, "every initial skill description clears wall health number")
		test.assert_true(paper.position.y + paper.size.y <= skill_rect.position.y, "every initial skill description keeps skill circle reachable")
		test.assert_true(tooltip.get_node("Paper/Description").get_theme_font_size("font_size") >= 28, "long descriptions remain readable")
	tooltip.dismiss()
	for id in [11, 12, 13]:
		app.session.factory.add_hero(id)
	view.render(app.battle_snapshot())
	for index in range(4):
		await mouse.click(tree, view.get_node("HUD/Hero%d/Skill" % index))
		var definition = app._catalog.record("heroes", app.battle_snapshot().heroes[index].template)
		test.assert_equal(tooltip.get_node("Paper/Description").text, app._catalog.record("options", int(definition.initial_options[0])).description, "each roster skill uses its own description")
		test.assert_true(not app.battle_snapshot().paused, "switching skill descriptions preserves running state")
	await mouse.click(tree, tooltip.get_node("Paper"))
	test.assert_true(not tooltip.visible and not app.battle_snapshot().paused, "clicking description closes it without activating portrait underneath")
	await mouse.click(tree, view.get_node("HUD/Hero0/Skill"))
	var escape = InputEventKey.new()
	escape.keycode = KEY_ESCAPE
	escape.pressed = true
	tree.root.push_input(escape, true)
	await tree.process_frame
	test.assert_true(not tooltip.visible and not app.battle_snapshot().paused, "Escape closes skill description without pausing")
	app.session.choices.offer("upgrade")
	view.render(app.battle_snapshot())
	await tree.create_timer(0.7).timeout
	var offers = app.battle_snapshot().offers.duplicate(true)
	await mouse.click(tree, view.get_node("HUD/Hero1/Skill"))
	test.assert_true(tooltip.visible and not app.battle_snapshot().paused, "skill description remains reachable during choice")
	test.assert_equal(app.battle_snapshot().offers, offers, "skill inspection preserves current choice candidates")
	await mouse.click(tree, choice.get_node("Cards/Card0"), Vector2(146, 315))
	await tree.create_timer(0.2).timeout
	test.assert_true(not tooltip.visible, "choosing upgrade dismisses skill description")
	await mouse.click(tree, view.get_node("HUD/Pause"))
	view.show_skill(0)
	test.assert_true(tooltip.visible and app.battle_snapshot().paused, "skill inspection preserves an existing manual pause")
	await mouse.click(tree, tooltip.get_node("Paper"))
	test.assert_true(not tooltip.visible and app.battle_snapshot().paused, "closing skill description does not resume a manual pause")
	await mouse.click(tree, panels.get_node("Pause/Resume"))
	await mouse.click(tree, view.get_node("HUD/Hero0/Portrait"))
	test.assert_true(terms.visible and not app.battle_snapshot().paused, "owned portrait opens selected terms while combat continues")
	test.assert_true(not panels.get_node("Pause").visible, "hero inspection does not open the pause surface")
	test.assert_true(not panels.get_node("Hero").visible, "owned portrait no longer opens attributes")
	test.assert_equal(terms.selected_hero_id, hero.id, "selected terms belong to the clicked runtime hero")
	var clock = app.battle_snapshot().time
	app.set_process(true)
	await tree.create_timer(0.15).timeout
	app.set_process(false)
	test.assert_true(app.battle_snapshot().time > clock, "real frame processing advances battle time while selected terms are visible")
	test.assert_true(terms.visible, "live battle snapshots keep selected terms open")
	await mouse.click(tree, terms.get_node("Backdrop"), Vector2(480, 1800))
	test.assert_true(not terms.visible and not app.battle_snapshot().paused, "blank-area dismissal leaves combat running")
	await mouse.click(tree, view.get_node("HUD/Hero1/Portrait"))
	test.assert_equal(terms.selected_hero_id, app.battle_snapshot().heroes[1].id, "next portrait displays the corresponding owned hero")
	test.assert_true(not app.battle_snapshot().paused, "opening another hero leaves combat running")
	tree.root.push_input(escape, true)
	await tree.process_frame
	test.assert_true(not terms.visible and not app.battle_snapshot().paused, "Escape dismisses selected terms without pausing")
	await mouse.click(tree, view.get_node("HUD/Pause"))
	view.show_terms(0)
	test.assert_true(terms.visible and app.battle_snapshot().paused, "hero inspection preserves an existing manual pause")
	clock = app.battle_snapshot().time
	app.session.step()
	test.assert_equal(app.battle_snapshot().time, clock, "manual pause still freezes the battle clock")
	await mouse.click(tree, terms.get_node("Backdrop"), Vector2(480, 1800))
	test.assert_true(app.battle_snapshot().paused and panels.get_node("Pause").visible, "closing terms returns to the existing manual pause")
	await mouse.click(tree, panels.get_node("Pause/Quit"))
	test.assert_equal(app.battle_snapshot().phase, "result", "pause quit uses actual result path")
	test.assert_true(not panels.get_node("Pause").visible, "result closes pause surface")
	app.queue_free()
	await tree.process_frame
