* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.ttf binary
*.zip binary

# Project art and audio are stored with Git LFS.
art_source/**/*.png filter=lfs diff=lfs merge=lfs -text
art_source/**/*.jpg filter=lfs diff=lfs merge=lfs -text
art_source/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
art_source/**/*.gif filter=lfs diff=lfs merge=lfs -text
art_source/**/*.webp filter=lfs diff=lfs merge=lfs -text
art_source/**/*.zip filter=lfs diff=lfs merge=lfs -text
art_source/**/*.blend filter=lfs diff=lfs merge=lfs -text

assets/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
assets/**/*.gif filter=lfs diff=lfs merge=lfs -text
assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
assets/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
assets/**/*.wav filter=lfs diff=lfs merge=lfs -text
assets/**/*.ogg filter=lfs diff=lfs merge=lfs -text
assets/**/*.ttf filter=lfs diff=lfs merge=lfs -text
