extends RefCounted

static func domain(t) -> void:
	var gear = DefenseEquipment.new()
	for part in DefenseEquipment.PARTS:
		for gem_type in ["a", "b", "c"]:
			gear.submit("gem_inlay", {"part": part, "item": "%s_gem_%s_1" % [part, gem_type]})
		var before = gear.snapshot()
		var item: String = before.sockets[part][1]
		for invalid in [-1, 3, 0.5]:
			t.verify(not gear.submit("gem_remove", {"part": part, "slot": invalid, "item": item}).is_empty(), "invalid remove slot " + part)
		t.verify(not gear.submit("gem_remove", {"part": part, "slot": 1, "item": "wrong_gem"}).is_empty(), "remove validates gem identity " + part)
		t.verify(gear.snapshot() == before, "rejected removal preserves inventory " + part)
		t.verify(gear.submit("gem_remove", {"part": part, "slot": 1, "item": item}).is_empty(), "remove middle gem " + part)
		var after = gear.snapshot()
		t.verify(after.sockets[part] == [before.sockets[part][0], before.sockets[part][2]], "remaining gems preserve order " + part)
		t.verify(after.gems[part].size() == 12 and after.gems[part].has(item), "removed gem returns to bag " + part)
		t.verify(after.worn == before.worn and after.spares == before.spares, "removing gems never unequips equipment " + part)
		t.verify(not gear.submit("gem_remove", {"part": part, "slot": 1, "item": item}).is_empty(), "stale removal does not remove next gem " + part)
		t.verify(gear.snapshot() == after, "duplicate removal cannot duplicate gem " + part)
		while not gear.snapshot().sockets[part].is_empty():
			gear.submit("gem_remove", {"part": part, "slot": 0, "item": gear.snapshot().sockets[part][0]})
		t.verify(gear.snapshot().gems[part].size() == 14, "all gems can be returned " + part)
		t.verify(not gear.submit("gem_remove", {"part": part, "slot": 0, "item": item}).is_empty(), "empty socket cannot be removed " + part)
		gear.submit("gem_inlay", {"part": part, "item": item})
		t.verify(gear.snapshot().sockets[part] == [item], "returned gem can be reinserted " + part)
	var catalog = DefenseCatalog.new()
	catalog.load_default()
	var session = DefenseSession.new(catalog)
	session.submit("gem_inlay", {"part": "head", "item": "head_gem_a_1"})
	session.submit("start", {"seed": 59})
	t.verify(not session.submit("gem_remove", {"part": "head", "slot": 0, "item": "head_gem_a_1"}).is_empty(), "combat blocks gem removal")
	t.verify(session.equipment.snapshot().sockets.head == ["head_gem_a_1"], "combat removal rejection preserves state")
	session.dispose()

static func run(t) -> void:
	domain(t)
	var page = t.page
	var worn = page.get_node("WornDialog")
	t.root.size = Vector2i(720, 1440)
	await t.process_frame
	await t.click(page.get_node("Gear/Slot0"))
	t.verify(worn.visible and not t.dialog.visible and worn.tab == "gems", "worn gear opens its own default gem tab")
	t.verify(worn.get_node("Shade").color.a > 0.5, "worn details darken background")
	await t.capture("worn_gems_720")
	await t.click(worn.get_node("Card/Equipment"))
	t.verify(worn.tab == "equipment" and worn.get_node("Card/EquipmentInfo").visible and not worn.get_node("Card/GemRows").visible, "equipment subtab changes content")
	await t.capture("worn_equipment_720")
	await t.click(worn.get_node("Card/Gems"))
	var before = t.app.session.equipment.snapshot()
	await t.click(worn.get_node("Card/GemRows/Slot2/Remove"))
	var after = t.app.session.equipment.snapshot()
	t.verify(after.sockets.head.size() == 4 and after.gems.head.has(before.sockets.head[2]), "real middle-row remove returns correct gem")
	t.verify(after.worn == before.worn and worn.visible and worn.tab == "gems", "remove keeps equipment and secondary page open")
	t.verify(not worn.get_node("Card/GemRows/Slot4/Remove").visible, "empty row has no remove action")
	t.verify(page.data.gems.head.size() == 10, "backpack snapshot refreshes immediately")
	t.verify_socket_types("head", ["a", "b", "f", "e"])
	await t.capture("worn_removed_720")
	await t.outside()
	t.verify(not worn.visible and t.home.current_page == "statue", "outside closes worn details without switching page")
	await t.click(page.get_node("Bag/Gems"))
	await t.open_gem("head", "c")
	await t.click(t.dialog.get_node("Left/Action"))
	t.verify(t.app.session.equipment.snapshot().sockets.head.size() == 5 and not t.dialog.selecting, "free slot after removal inlays directly")
	t.verify_socket_types("head", ["a", "b", "f", "e", "c"])
	await t.click(t.dialog.get_node("Left/Action"))
	t.verify(t.dialog.selecting, "full-slot replacement still works after reinlay")
	await t.outside()
	await t.outside()
	await t.click(page.get_node("Gear/Slot0"))
	t.root.size = Vector2i(480, 960)
	await t.process_frame
	await t.capture("worn_gems_480")
	await t.click(worn.get_node("Card/Equipment"))
	t.verify(worn.tab == "equipment", "480 subtab input")
	await t.capture("worn_equipment_480")
	await t.click(worn.get_node("Card/Gems"))
	await t.click(worn.get_node("Card/GemRows/Slot4/Remove"))
	t.verify(t.app.session.equipment.snapshot().sockets.head.size() == 4, "480 remove input")
	await t.press_escape()
	t.verify(not worn.visible and t.home.current_page == "statue", "Escape closes worn details first")
	for index in range(6):
		var part: String = page.DISPLAY_PARTS[index]
		if t.app.session.equipment.snapshot().sockets[part].is_empty():
			t.app.submit("gem_inlay", {"part": part, "item": t.app.session.equipment.snapshot().gems[part][0]})
		await t.click(page.get_node("Gear/Slot%d" % index))
		t.verify(worn.part == part and worn.tab == "gems", "all worn slots open correct part " + part)
		while not t.app.session.equipment.snapshot().sockets[part].is_empty():
			await t.click(worn.get_node("Card/GemRows/Slot0/Remove"))
		t.verify(t.app.session.equipment.snapshot().gems[part].size() == 14, "UI returns every gem " + part)
		t.verify(not worn.get_node("Card/GemRows/Slot0/Remove").visible, "empty UI hides removal " + part)
		t.verify_socket_types(part, [])
		await t.outside()
	t.root.size = Vector2i(960, 1920)
	await t.process_frame
	await t.click(page.get_node("Gear/Slot0"))
	await t.capture("worn_empty_960")
	t.home.show_page("heroes")
	t.verify(not worn.visible, "leaving statue page clears worn dialog")
	await t.click(t.home.get_node("Statue"))
	await t.click(page.get_node("Bag/Equipment"))
	await t.click(page.get_node("Bag/Scroll/Items").get_child(0))
	t.verify(t.dialog.visible and t.dialog.get_node("Right").visible and not worn.visible, "backpack gear still opens comparison")
	var current: String = t.app.session.equipment.snapshot().worn.head
	await t.click(t.dialog.get_node("Right/Action"))
	t.verify(t.app.session.equipment.snapshot().worn.head != current, "equipment replacement still succeeds")
